<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    
    <record id="action_my_model" model="ir.actions.act_window">
        <field name="name">Danh sách lớp</field>
        <field name="res_model">my</field>
        <!-- view_mode liệt kê các view mà action sẽ sử dụng -->
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click vào "Create" để thêm thông tin!
            </p>
        </field>
    </record>

    <menuitem id="menu_my_root" name="Module Mới" sequence="10"/>

    <menuitem id="menu_my_list"
              name="Danh sách lớp"
              parent="menu_my_root"
              action="action_my_model"
              sequence="20"/>

    <record id="view_my_list" model="ir.ui.view">
        <field name="name">my.list</field>
        <field name="model">my</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Danh sách cá nhân">
                <field name="name"/>
                <field name="age"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_my_form" model="ir.ui.view">
        <field name="name">my.form</field>
        <field name="model">my</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Thông tin cá nhân">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="email"/>
                    </group>
                    <group>
                        <field name="bio"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
