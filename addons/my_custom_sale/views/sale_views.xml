<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kế thừa view form đơn hàng -->
    <record id="view_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Thêm trường vào header -->
            <field name="date_order" position="after">
                <field name="custom_reference" placeholder="Mã tham chiếu tùy chỉnh"/>
                <field name="priority" widget="priority"/>
            </field>
            
            <!-- Thêm tab mới -->
            <xpath expr="//notebook" position="inside">
                <page string="Thông tin thêm">
                    <group>
                        <group>
                            <field name="expected_delivery_date"/>
                            <field name="total_weight" widget="float" digits="[14,2]"/>
                        </group>
                        <group>
                            <field name="customer_notes" placeholder="Ghi chú từ khách hàng..."/>
                        </group>
                    </group>
                </page>
            </xpath>
            
            <!-- Thêm trường vào dòng đơn hàng -->
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="after">
                <field name="is_discount_item"/>
            </xpath>
            
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="after">
                <field name="is_discount_item"/>
                <field name="line_notes" placeholder="Ghi chú cho dòng sản phẩm này..."/>
            </xpath>
        </field>
    </record>
    
    <!-- Thêm filter và groupby vào search view -->
    <record id="view_sales_order_filter_inherit" model="ir.ui.view">
        <field name="name">sale.order.list.select.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Ưu tiên cao" name="high_priority" domain="[('priority', '=', '2')]"/>
            </filter>
            <filter name="salesperson" position="after">
                <filter string="Mức độ ưu tiên" name="priority" context="{'group_by': 'priority'}"/>
            </filter>
        </field>
    </record>
</odoo>