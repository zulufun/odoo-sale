<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_suggest_date_wizard_form" model="ir.ui.view">
        <field name="name">x_suggest_date_wizard.form</field>
        <field name="model">x_suggest_date_wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="message"/>
                    <field name="suggested_date"/>
                </group>
                <footer>
                    <button name="apply_suggested_date" string="Áp dụng ngày" type="object" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>