<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Ensure fixed-date Vietnamese holidays are created -->
        <function model="hr.public.holiday" name="create_default_vietnam_holidays"/>

        <!-- Tết Âm lịch for 2025 -->
        <record id="holiday_tet_2025_1" model="hr.public.holiday">
            <field name="name">Tết Âm lịch - Ngày 29/12</field>
            <field name="date">2025-01-27</field>
            <field name="country_id" ref="base.vn"/>
            <field name="description">Ngày 29 tháng Chạp Âm lịch</field>
        </record>

        <record id="holiday_tet_2025_2" model="hr.public.holiday">
            <field name="name">Tết Âm lịch - Ngày 30/12</field>
            <field name="date">2025-01-28</field>
            <field name="country_id" ref="base.vn"/>
            <field name="description">Ngày 30 tháng Chạp Âm lịch</field>
        </record>

        <record id="holiday_tet_2025_3" model="hr.public.holiday">
            <field name="name">Tết Âm lịch - Ngày 1/1</field>
            <field name="date">2025-01-29</field>
            <field name="country_id" ref="base.vn"/>
            <field name="description">Mùng 1 Tết Âm lịch</field>
        </record>

        <record id="holiday_tet_2025_4" model="hr.public.holiday">
            <field name="name">Tết Âm lịch - Ngày 2/1</field>
            <field name="date">2025-01-30</field>
            <field name="country_id" ref="base.vn"/>
            <field name="description">Mùng 2 Tết Âm lịch</field>
        </record>

        <record id="holiday_tet_2025_5" model="hr.public.holiday">
            <field name="name">Tết Âm lịch - Ngày 3/1</field>
            <field name="date">2025-01-31</field>
            <field name="country_id" ref="base.vn"/>
            <field name="description">Mùng 3 Tết Âm lịch</field>
        </record>

        <!-- Giỗ Tổ Hùng Vương for 2025 -->
        <record id="holiday_hung_kings_2025" model="hr.public.holiday">
            <field name="name">Giỗ Tổ Hùng Vương</field>
            <field name="date">2025-04-18</field>
            <field name="country_id" ref="base.vn"/>
            <field name="description">Ngày 10 tháng 3 Âm lịch</field>
        </record>

        <!-- Giỗ Tổ Hùng Vương for 2025 -->
        <record id="holiday_hung_kings_2025" model="hr.public.holiday">
            <field name="name">Giỗ Tổ Hùng Vương</field>
            <field name="date">2025-04-18</field>
            <field name="country_id" ref="base.vn"/>
            <field name="description">Ngày 10 tháng 3 Âm lịch</field>
        </record>
    </data>
</odoo>
<!-- 
Các ngày lễ cố định ở Việt Nam cho năm 2025 như Tết Dương lịch (Ngày đầu năm mới), Ngày Giải phóng miền Nam, Quốc tế Lao động, và Quốc khánh 
đã được xử lý tự động bởi hàm <function model="hr.public.holiday" name="create_default_vietnam_holidays"/> trong file data/data.xml. 
Hàm này được định nghĩa trong file hr_public_holiday.py của module ngày lễ công cộng HR và sẽ tự động tạo ra các ngày lễ này cho năm đã chỉ định (mặc định là năm hiện tại nếu không được chỉ định). 
Do đó, không cần phải định nghĩa chúng một cách thủ công dưới dạng các mục <record> trong file data.xml, vì chúng đã được xử lý tự động trong mã nguồn.
 -->
