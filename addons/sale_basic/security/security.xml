<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_simple_sale_category" model="ir.module.category">
        <field name="name">Bán hàng đơn giản</field>
    </record>

    <record id="group_simple_sale_user" model="res.groups">
        <field name="name">Người dùng</field>
        <field name="category_id" ref="module_simple_sale_category"/>
    </record>

    <record id="group_simple_sale_manager" model="res.groups">
        <field name="name">Quản lý</field>
        <field name="category_id" ref="module_simple_sale_category"/>
        <field name="implied_ids" eval="[(4, ref('group_simple_sale_user'))]"/>
    </record>
</odoo>
