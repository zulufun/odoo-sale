<odoo>
    <!-- Action for Products in Inventory -->
    <record id="action_product_inventory_list" model="ir.actions.act_window">
        <field name="name">Products in Inventory</field>
        <field name="res_model">custom.product.inventory</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tree View for Products in Inventory -->
    <record id="view_product_inventory_tree" model="ir.ui.view">
        <field name="name">custom.product.inventory.tree</field>
        <field name="model">custom.product.inventory</field>
        <field name="arch" type="xml">
            <tree string="Products in Inventory">
                <field name="name"/>
                <field name="product_id"/>
                <field name="quantity_available"/>
                <field name="list_price"/>
                <field name="standard_price"/>
                <field name="categ_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Products in Inventory -->
    <record id="view_product_inventory_form" model="ir.ui.view">
        <field name="name">custom.product.inventory.form</field>
        <field name="model">custom.product.inventory</field>
        <field name="arch" type="xml">
            <form string="Product Inventory">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="quantity_available"/>
                        <field name="list_price"/>
                        <field name="standard_price"/>
                        <field name="categ_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Menu Item for Products Manager -->
    <menuitem id="product_inventory_manager_menu" name="Products Manager" sequence="10"/>
    
    <!-- Submenu for Products in Inventory -->
    <menuitem id="product_inventory_submenu" name="Products in Inventory" parent="product_inventory_manager_menu" action="action_product_inventory_list"/>
</odoo>