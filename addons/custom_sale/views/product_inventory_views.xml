<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View for Product Inventory -->
    <record id="view_custom_product_inventory_tree" model="ir.ui.view">
        <field name="name">custom.product.inventory.tree</field>
        <field name="model">custom.product.inventory</field>
        <field name="arch" type="xml">
            <tree string="Product Inventory">
                <field name="product_id"/>
                <field name="product_name"/>
                <field name="qty_available"/>
                <field name="virtual_available"/>
                <field name="incoming_qty"/>
                <field name="outgoing_qty"/>
                <field name="uom_id"/>
                <field name="categ_id"/>
                <field name="list_price" widget="monetary"/>
                <field name="standard_price" widget="monetary"/>
            </tree>
        </field>
    </record>

    <!-- Search View for Product Inventory -->
    <record id="view_custom_product_inventory_search" model="ir.ui.view">
        <field name="name">custom.product.inventory.search</field>
        <field name="model">custom.product.inventory</field>
        <field name="arch" type="xml">
            <search string="Product Inventory">
                <field name="product_name" string="Product" filter_domain="[('product_name', 'ilike', self)]"/>
                <field name="categ_id"/>
                <separator/>
                <filter string="In Stock" name="in_stock" domain="[('qty_available', '>', 0)]"/>
                <filter string="Out of Stock" name="out_of_stock" domain="[('qty_available', '&lt;=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Product Category" name="group_by_category" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form View for Product Inventory -->
    <record id="view_custom_product_inventory_form" model="ir.ui.view">
        <field name="name">custom.product.inventory.form</field>
        <field name="model">custom.product.inventory</field>
        <field name="arch" type="xml">
            <form string="Product Inventory" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_name"/>
                            <field name="categ_id"/>
                            <field name="uom_id"/>
                        </group>
                        <group>
                            <field name="qty_available"/>
                            <field name="virtual_available"/>
                            <field name="incoming_qty"/>
                            <field name="outgoing_qty"/>
                            <field name="list_price" widget="monetary"/>
                            <field name="standard_price" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View for Product Inventory -->
    <record id="view_custom_product_inventory_kanban" model="ir.ui.view">
        <field name="name">custom.product.inventory.kanban</field>
        <field name="model">custom.product.inventory</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="product_id"/>
                <field name="product_name"/>
                <field name="qty_available"/>
                <field name="list_price"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="product_name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <span class="badge badge-pill">
                                        Category: <field name="categ_id"/>
                                    </span>
                                </div>
                                <ul>
                                    <li>Price: <field name="list_price" widget="monetary"/></li>
                                    <li>Quantity On Hand: <field name="qty_available"/></li>
                                    <li>Forecasted: <field name="virtual_available"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action for Product Inventory -->
    <record id="action_custom_product_inventory" model="ir.actions.act_window">
        <field name="name">Products in Inventory</field>
        <field name="res_model">custom.product.inventory</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="view_custom_product_inventory_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products found in inventory
            </p>
            <p>
                This view shows all the products available in your inventory.
            </p>
        </field>
    </record>

    <!-- Website Template for Controller -->
    <template id="product_inventory_page" name="Product Inventory">
        <t t-call="website.layout">
            <div class="container">
                <h1 class="mt-4 mb-4">Products in Inventory</h1>
                <div class="row">
                    <t t-foreach="products" t-as="product">
                        <div class="col-md-4 mb-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title"><t t-esc="product.product_name"/></h5>
                                    <p class="card-text">
                                        <strong>Quantity On Hand:</strong> <t t-esc="product.qty_available"/><br/>
                                        <strong>Price:</strong> <t t-esc="product.list_price"/><br/>
                                        <strong>Category:</strong> <t t-esc="product.categ_id.name"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>